{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sprigboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Served only on Ben's subdomain. Cloudflare creates the DNS record for a
  // custom domain itself; nothing else in the appui.com.au zone is touched.
  "routes": [{ "pattern": "sprigboard.appui.com.au", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sprigboard-db",
      // Created 2026-11-06 on Ben's account, Oceania region.
      "database_id": "1173cda8-2adb-440e-b059-a12d9436e2db",
      "migrations_dir": "migrations"
    }
  ],
  // R2 isn't enabled on Ben's account yet. Once it is, create the bucket
  // (`npx wrangler r2 bucket create sprigboard-files`), uncomment this and deploy.
  // Until then uploads show "File storage isn't turned on yet".
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "sprigboard-files" }],
  "vars": {
    "APP_URL": "https://sprigboard.appui.com.au",
    "MAIL_FROM": "Sprigboard <noreply@velosolabs.com>",
    // Workers Free allows 10 ms CPU per request; see docs/SETUP.md "CPU limits".
    "PASSWORD_ITERATIONS": "100000"
  },
  // Anything set in the dashboard survives a deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
  // Secrets (dashboard or `wrangler secret put`, never in this file):
  //   ANTHROPIC_API_KEY, MAILJET_API_KEY, MAILJET_API_SECRET,
  //   BOOTSTRAP_EMAILS (comma-separated emails that may sign in by code before they have an account)
}
